# Радиусы размытия и параметры Canny
blur_radii = [5, 11, 21]
canny_thresholds = [(50, 150), (100, 200)]

# Обрабатываем изображения
for image_name in image_files:
    img_path = os.path.join(image_folder, image_name)
    img = cv2.imread(img_path)
    img = cv2.resize(img, new_size)

    # Создаем фигуру для отображения
    plt.figure(figsize=(12, 8))

    # Исходное изображение
    plt.subplot(3, 3, 1)
    plt.imshow(cv2.cvtColor(img, cv2.COLOR_BGR2RGB))
    plt.title("Исходное изображение")
    plt.axis("off")

    # Применяем размытие по Гауссу и обнаружение краев
    for i, radius in enumerate(blur_radii):
        blurred_img = cv2.GaussianBlur(img, (radius, radius), 0)
        plt.subplot(3, 3, i + 2)
        plt.imshow(cv2.cvtColor(blurred_img, cv2.COLOR_BGR2RGB))
        plt.title(f"Gaussian Blur (r={radius})")
        plt.axis("off")

        for j, (low, high) in enumerate(canny_thresholds):
            canny_img = cv2.Canny(blurred_img, low, high)
            plt.subplot(3, 3, 4 + i * 2 + j)
            plt.imshow(canny_img, cmap='gray')
            plt.title(f"Canny ({low}, {high})")
            plt.axis("off")

    plt.tight_layout()
    plt.show()
